<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MyDownloader.App.ViewModels"
        xmlns:core="using:MyDownloader.Core"
        x:Class="MyDownloader.App.Views.TaskDetailWindow"
        x:DataType="vm:TaskDetailViewModel"
        Title="下载任务" Icon="/Assets/app.ico"
        Width="660" Height="560" MinWidth="540" MinHeight="440"
        Background="{DynamicResource PageBgBrush}">
  <DockPanel Margin="14" LastChildFill="True">

    <!-- 文件信息卡片 -->
    <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,12">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding FileName}" Classes="cardtitle" TextTrimming="CharacterEllipsis"/>
        <SelectableTextBlock Text="{Binding Url}" Classes="muted" TextTrimming="CharacterEllipsis"/>
        <SelectableTextBlock Text="{Binding FilePath}" Classes="muted" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
    </Border>

    <!-- 控制按钮卡片 -->
    <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,12" Padding="12,10">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="secondary" Content="暂停" Command="{Binding PauseCommand}"/>
        <Button Classes="secondary" Content="继续" Command="{Binding ResumeCommand}"/>
        <Button Classes="secondary" Content="取消" Command="{Binding CancelCommand}"/>
        <Button Classes="primary" Content="重新下载" Command="{Binding RedownloadCommand}"/>
      </StackPanel>
    </Border>

    <!-- 总进度卡片 -->
    <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,12">
      <StackPanel Spacing="8">
        <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Height="16" CornerRadius="8"/>
        <StackPanel Orientation="Horizontal" Spacing="20">
          <TextBlock Classes="muted" Text="{Binding SpeedText, StringFormat='速度  {0}'}"/>
          <TextBlock Classes="muted" Text="{Binding OverviewText, StringFormat='总览  {0}'}"/>
          <TextBlock Classes="muted" Text="{Binding EtaText, StringFormat='剩余  {0}'}"/>
          <TextBlock Classes="muted" Text="{Binding StatusText}"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- 分块进度卡片 -->
    <Border Classes="card" Padding="0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="分块进度" Classes="cardtitle" FontSize="14"
                   Margin="14,12,14,8"/>
        <ScrollViewer Margin="14,0,14,14">
          <ItemsControl ItemsSource="{Binding Chunks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="core:ChunkSnapshot">
                <Grid ColumnDefinitions="56,*,84" Margin="0,4">
                  <TextBlock Text="{Binding Index, StringFormat='块 {0}'}" Classes="muted"
                             VerticalAlignment="Center"/>
                  <ProgressBar Grid.Column="1" Value="{Binding Progress}" Minimum="0" Maximum="100"
                               Height="12" VerticalAlignment="Center" CornerRadius="6"/>
                  <Border Grid.Column="2" Classes="pill"
                          Background="{Binding State, Converter={x:Static vm:Converters.ChunkStateToBrush}}"
                          HorizontalAlignment="Right">
                    <TextBlock Text="{Binding State}" Foreground="White" FontSize="11"/>
                  </Border>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </DockPanel>
</Window>
