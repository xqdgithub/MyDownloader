<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MyDownloader.App.ViewModels"
        x:Class="MyDownloader.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="MyDownloader" Icon="/Assets/app.ico"
        Width="1120" Height="640" MinWidth="860" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBgBrush}"
        DragDrop.AllowDrop="True">
  <Window.Styles>
    <Style Selector="DataGridRow">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill" Value="{DynamicResource RowHoverBrush}"/>
    </Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
  </Window.Styles>

  <DockPanel Margin="14" LastChildFill="True">

    <!-- 顶部卡片工具栏 -->
    <Border DockPanel.Dock="Top" Classes="card" Padding="12" Margin="0,0,0,12">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Grid.Column="0" Name="AddButton" Classes="primary" Content="+  新建下载"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button Name="PauseAllButton" Classes="secondary" Content="暂停全部"
                  Command="{Binding PauseAllCommand}" ToolTip.Tip="暂停所有下载任务"/>
          <Button Name="ResumeAllButton" Classes="secondary" Content="继续全部"
                  Command="{Binding ResumeAllCommand}" ToolTip.Tip="继续所有已暂停任务"/>
          <Button Name="ThemeButton" Classes="secondary" Content="主题"
                  ToolTip.Tip="切换浅色 / 深色"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 底部状态栏卡片 -->
    <Border DockPanel.Dock="Bottom" Classes="card" Padding="12,8" Margin="0,12,0,0">
      <StackPanel Orientation="Horizontal" Spacing="28">
        <TextBlock Classes="muted" Text="{Binding TotalSpeedText, StringFormat='总速度  {0}'}"/>
        <TextBlock Classes="muted" Text="{Binding ActiveCount, StringFormat='活动任务  {0}'}"/>
        <TextBlock Classes="muted" Text="{Binding CompletedCount, StringFormat='已完成  {0}'}"/>
      </StackPanel>
    </Border>

    <!-- 任务列表卡片 -->
    <Border Classes="card" Padding="0">
      <Grid>
        <DataGrid ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="None"
                  HeadersVisibility="Column"
                  CanUserResizeColumns="True"
                  DoubleTapped="OnRowDoubleTapped"
                  Background="Transparent"
                  Name="TaskGrid">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="文件名" Width="*" MinWidth="180">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:TaskItemViewModel">
                  <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="100"/>
            <DataGridTemplateColumn Header="进度" Width="200">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:TaskItemViewModel">
                  <Grid VerticalAlignment="Center">
                    <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100"
                                 Height="18" VerticalAlignment="Center" CornerRadius="9"
                                 Background="#C9CDD4" Foreground="{Binding ProgressBrush}"/>
                    <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                               Foreground="White"/>
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="速度" Binding="{Binding SpeedText}" Width="90"/>
            <DataGridTextColumn Header="剩余" Binding="{Binding EtaText}" Width="80"/>
            <DataGridTemplateColumn Header="状态" Width="88">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:TaskItemViewModel">
                  <Border Classes="pill" Background="{Binding StatusBrush}">
                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="12"/>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="操作" Width="Auto">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:TaskItemViewModel">
                  <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Classes="rowaction" Content="暂停" IsVisible="{Binding CanPause}"
                            Command="{Binding $parent[DataGrid].((vm:MainViewModel)DataContext).PauseItemCommand}"
                            CommandParameter="{Binding}"/>
                    <Button Classes="rowaction" Content="{Binding ResumeText}" IsVisible="{Binding CanResume}"
                            Command="{Binding $parent[DataGrid].((vm:MainViewModel)DataContext).ResumeItemCommand}"
                            CommandParameter="{Binding}"/>
                    <Button Classes="rowaction danger" Content="取消" IsVisible="{Binding CanCancel}"
                            Command="{Binding $parent[DataGrid].((vm:MainViewModel)DataContext).CancelItemCommand}"
                            CommandParameter="{Binding}"/>
                    <Button Classes="rowaction" Content="查看"
                            Command="{Binding $parent[DataGrid].((vm:MainViewModel)DataContext).ViewDetailCommand}"
                            CommandParameter="{Binding}"/>
                    <Button Classes="rowaction" Content="打开" IsVisible="{Binding CanOpen}"
                            Command="{Binding $parent[DataGrid].((vm:MainViewModel)DataContext).OpenItemCommand}"
                            CommandParameter="{Binding}"/>
                    <Button Classes="rowaction" Content="重下" IsVisible="{Binding CanRedownload}"
                            Command="{Binding $parent[DataGrid].((vm:MainViewModel)DataContext).RedownloadItemCommand}"
                            CommandParameter="{Binding}"/>
                    <Button Classes="rowaction" Content="删除"
                            Command="{Binding $parent[DataGrid].((vm:MainViewModel)DataContext).RemoveItemCommand}"
                            CommandParameter="{Binding}"/>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <!-- 空列表占位 -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                    IsVisible="{Binding !Items.Count}"
                    IsHitTestVisible="False">
          <TextBlock Text="↓" FontSize="48" Foreground="{DynamicResource PrimaryBrush}"
                     HorizontalAlignment="Center"/>
          <TextBlock Text="暂无下载任务" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"
                     HorizontalAlignment="Center"/>
          <TextBlock Classes="muted" Text="点击左上角「新建下载」开始，或把链接拖到窗口"
                     HorizontalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </Border>
  </DockPanel>
</Window>
